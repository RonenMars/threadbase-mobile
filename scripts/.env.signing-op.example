# op reference config for bootstrap-local-signing-op.sh.
# Copy to scripts/.env.signing-op (gitignored) and point it at YOUR 1Password entry.
# These are NOT secrets — just the vault/item/field NAMES op reads the secrets from.

# 1Password vault + item holding the App Store Connect credentials.
export OP_VAULT='MyVault'
export OP_ITEM='AppStoreConnect'

# Field labels within that item. Defaults shown; override only if yours differ.
export OP_KEY_ID_FIELD='key_id'
export OP_ISSUER_ID_FIELD='issuer_id'
export OP_TEAM_ID_FIELD='team_id'
export OP_AUTH_KEY_B64_FIELD='auth_key_b64'            # base64 of the ASC .p8 API key
export OP_PROFILE_UUID_FIELD='provision_profile_uuid' # UUID of the App Store dist profile
export OP_WIDGET_PROFILE_UUID_FIELD='widget_provision_profile_uuid' # UUID of the widget dist profile

# Optional — base64 of the .mobileprovision files, used only when a profile is
# missing from Xcode's local cache. Populate with:
#   base64 -i <profile>.mobileprovision | op item edit "$OP_ITEM" --vault "$OP_VAULT" 'provision_profile_b64[password]=-'
export OP_PROFILE_B64_FIELD=provision_profile_b64
export OP_WIDGET_PROFILE_B64_FIELD=widget_provision_profile_b64

# Optional — Sentry credentials for the archive-time dSYM upload, the sourcemap
# upload, and the release/deploy creation after a successful store upload.
# Skip this block entirely if SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT are
# already exported in your shell — the ship scripts read those directly and this
# block only exists to fetch them when they aren't. With neither route the archive
# fails unless SENTRY_DISABLE_AUTO_UPLOAD=true, which costs symbolication.
export OP_SENTRY_VAULT='MyVault'
export OP_SENTRY_ITEM='Sentry'
# Field-name overrides if your item labels differ:
# export OP_SENTRY_TOKEN_FIELD=token
# export OP_SENTRY_ORG_FIELD=org_slug
# export OP_SENTRY_PROJECT_FIELD=project

# Optional — Android upload keystore. Omit the block to skip the Android half
# (--platform android then has nothing to do). Populate the keystore field with:
#   base64 -i ~/.android-signing/tb-mobile-upload.keystore
export OP_ANDROID_VAULT='MyVault'
export OP_ANDROID_ITEM='AndroidUploadKeystore'
# Field-name overrides if your item labels differ:
# export OP_ANDROID_KEYSTORE_B64_FIELD=keystore_b64
# export OP_ANDROID_STORE_PASSWORD_FIELD=store_password
# export OP_ANDROID_KEY_ALIAS_FIELD=key_alias
# export OP_ANDROID_KEY_PASSWORD_FIELD=key_password

# Optional — Google Play publisher service account, the JSON that authorizes the
# track upload. It is the one credential with no local fallback: without it
# ship-android.sh aborts at its first step. Populate with:
#   base64 -i <play-console-sa>.json
# Set the field override to 'password' when the item is a Password-category item,
# whose value lives in the built-in `password` field rather than a custom one.
export OP_PLAY_VAULT='MyVault'
export OP_PLAY_ITEM='PlayConsoleServiceAccount'
# export OP_PLAY_SA_JSON_B64_FIELD=sa_json_b64
