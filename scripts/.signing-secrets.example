# Copy to scripts/.signing-secrets (gitignored) and fill in real values.
# Values come from your GitHub Actions secrets (gh secret list shows the names,
# not the values), your Apple Developer account, or your password manager.

# --- Required (bootstrap hard-fails without these) ---
export ASC_KEY_ID=''            # App Store Connect API key ID
export ASC_ISSUER_ID=''         # App Store Connect issuer ID
export ASC_TEAM_ID='GUW6BN8X57' # Apple team ID (matches app.json ios.appleTeamId)

# The .p8 API key: give EITHER the file path OR the raw base64 (not both).
export ASC_AUTH_KEY_FILE=''     # e.g. /path/AuthKey_ABC123.p8   (base64'd automatically)
# export ASC_AUTH_KEY_B64=''    # ...or paste base64 of the .p8 directly

# --- Needed for Manual-signing archive (the part that was missing) ---
export IOS_PROVISION_PROFILE_UUID=''   # UUID of the distribution provisioning profile
export IOS_PROVISION_PROFILE_FILE=''   # e.g. /path/Threadbase_AppStore.mobileprovision
# export IOS_PROVISION_PROFILE_B64=''  # ...or paste base64 of the .mobileprovision directly

# --- Distribution cert: SKIP all three if the cert is already in your login keychain ---
# export IOS_DIST_CERT_FILE=''         # e.g. /path/dist.p12   (base64'd automatically)
# export IOS_DIST_CERT_P12_B64=''      # ...or paste base64 of the .p12 directly
# export IOS_DIST_CERT_PASSWORD=''     # .p12 export password
