#!/usr/bin/env bash
# pre-commit: keep path-dependent SPEC CHECKSUM noise out of ios/Podfile.lock.
#
# ExpoModulesCore, ExpoWidgets, hermes-engine and RNSentry hash a generated
# podspec that carries the checkout's absolute path, so every machine, worktree
# and CI runner produces a different checksum for the same pod at the same
# version. Committing those makes ios/Podfile.lock ping-pong between whoever ran
# `pod install` last and is the usual source of rebase conflicts on that file.
#
# reset-podfile-lock-path-noise.sh reverts the lockfile (index included) only
# when the drift is limited to those four lines; a genuine pod change also moves
# that pod's version line and is left alone. It resyncs ios/Pods/Manifest.lock to
# match, so the reverted lockfile still passes Xcode's "[CP] Check Pods
# Manifest.lock" phase on the next build.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
RESET="$REPO_ROOT/scripts/reset-podfile-lock-path-noise.sh"

if git diff --cached --name-only --diff-filter=ACMR | grep -qxF 'ios/Podfile.lock'; then
  [ -x "$RESET" ] && "$RESET"
fi

# Mandatory Storybook coverage: a new components/*.tsx file must ship with a
# matching *.stories.tsx (see docs/storybook.md). Modified components only warn.
node "$REPO_ROOT/scripts/check-story-coverage.js"

# i18n: block a commit that introduces a hardcoded user-facing string.
#
# `i18next/no-literal-string` runs at `error` in eslint.config.js, so CI's Lint
# job already catches these. Doing it here too turns a red pipeline into a
# message before the commit exists. Only staged .ts/.tsx files are linted, and
# only this rule's findings are reported: a full `npx eslint .` takes minutes
# and surfaces 266 pre-existing errors from unrelated rules, which would bury
# the one line that matters.
#
# `--no-verify` bypasses this. The same rule in CI cannot be bypassed.
STAGED_TS="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)"
if [ -n "$STAGED_TS" ]; then
  node "$REPO_ROOT/scripts/check-staged-i18n.js" $STAGED_TS
fi
