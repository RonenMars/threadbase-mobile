# Copy to .env and fill in
EXPO_PUBLIC_DEFAULT_SERVER_URL=http://localhost:8766
EXPO_PUBLIC_DEFAULT_API_KEY=tb_api_sample
# Note: actual server URL + API key are stored in SecureStore at runtime

# Stable cloudflared tunnel hostname for remote dev (npm run dev:metro).
# See docs/remote-dev-tunnel.md.
EXPO_PACKAGER_PROXY_URL=https://metro.rbv1000.win
