# Copy to .env and fill in
EXPO_PUBLIC_DEFAULT_SERVER_URL=http://localhost:8766
EXPO_PUBLIC_DEFAULT_API_KEY=tb_api_sample
# Note: actual server URL + API key are stored in SecureStore at runtime

# Stable cloudflared tunnel hostname for remote dev (npm run dev:metro).
# See docs/remote-dev-tunnel.md.
EXPO_PACKAGER_PROXY_URL=https://metro.rbv1000.win

# ── Crash reporting (Sentry) — optional, opt-in ──────────────────────────────
# Public Sentry DSN. Safe to embed in the client bundle by design (it is NOT a
# secret). Crash reporting stays fully disabled unless BOTH this is set AND the
# user opts in via Settings. Leave blank to keep crash reporting unavailable.
# See docs/sentry-setup.md.
EXPO_PUBLIC_SENTRY_DSN=

# Set to 1 ONLY for local QA of the reporting pipeline — allows Sentry to
# transmit from a development build. Never set this in committed env files.
# EXPO_PUBLIC_SENTRY_ALLOW_DEV=1

# NOTE: the Sentry source-map upload auth token (SENTRY_AUTH_TOKEN) is a SECRET
# and must live ONLY in the EAS build environment (sensitive visibility), never
# here and never committed. See docs/sentry-setup.md.

# ── Feedback endpoint — optional ─────────────────────────────────────────────
# Optional HTTPS endpoint for a future developer-operated feedback backend. When
# set, user feedback is POSTed here (sanitized allowlist schema only). When
# unset, feedback falls back to Sentry User Feedback (if crash reporting is on),
# then the native mail composer, then a copy-to-clipboard flow.
EXPO_PUBLIC_FEEDBACK_ENDPOINT=
