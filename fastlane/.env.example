# Copy this file to `fastlane/.env` and fill in the values.
# `fastlane/.env*` is gitignored, so the real values stay on your machine.
#
# Fastlane auto-loads `fastlane/.env`. To use a different environment, name the
# file `fastlane/.env.<environment>` and run `bundle exec fastlane beta --env <environment>`.

# --- App identity (required) -----------------------------------------------
# Bundle identifier — must match app.json -> expo.ios.bundleIdentifier.
APP_BUNDLE_ID=com.example.yourapp

# Xcode scheme name (also the directory name under ios/, e.g. ios/<APP_SCHEME>/Info.plist).
APP_SCHEME=YourScheme

# --- App Store Connect API key (required) ----------------------------------
# Create at https://appstoreconnect.apple.com/access/integrations/api
# Role: App Manager. Apple lets you download the .p8 exactly once — store it
# somewhere safe outside the repo.
ASC_KEY_ID=ABCD123456
ASC_ISSUER_ID=69a6de70-XXXX-XXXX-XXXX-XXXXXXXXXXXX
ASC_KEY_PATH=/absolute/path/to/AuthKey_ABCD123456.p8

# --- Optional: interactive Apple ID fallback -------------------------------
# Only needed if you ever want to bypass the API key (e.g. for a one-off
# action that requires Apple ID auth). The default lane never uses these.
# APPLE_ID=your-apple-id@example.com
# ITC_TEAM_ID=123456789
# APPLE_TEAM_ID=ABCDE12345
