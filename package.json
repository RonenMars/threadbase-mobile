{
  "name": "threadbase-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --forceExit",
    "test:unit": "jest --ci --testPathPattern='__tests__/unit'",
    "test:integration": "jest --ci --testPathPattern='__tests__/integration'",
    "test:e2e": "jest --ci --testPathPattern='__tests__/e2e'",
    "test:e2e:mock": "node e2e/check-sim.js && node e2e/mock-server.js & MOCK_PID=$! && sleep 1 && maestro test e2e/03_hub.yaml && maestro test e2e/04_session_detail.yaml; kill $MOCK_PID 2>/dev/null || true",
    "test:e2e:filters": "node e2e/check-sim.js && node e2e/mock-server.js & MOCK_PID=$! && sleep 1 && maestro test e2e/05_filter_status.yaml && maestro test e2e/06_sort_hub.yaml; kill $MOCK_PID 2>/dev/null || true",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.100.9",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-persist-client": "^5.100.9",
    "clsx": "^2.1.1",
    "expo": "56.0.0-canary-20260501-15d3529",
    "expo-camera": "56.0.0-canary-20260501-15d3529",
    "expo-clipboard": "56.0.0-canary-20260501-15d3529",
    "expo-constants": "56.0.0-canary-20260501-15d3529",
    "expo-dev-client": "56.0.0-canary-20260501-15d3529",
    "expo-font": "56.0.0-canary-20260501-15d3529",
    "expo-haptics": "56.0.0-canary-20260501-15d3529",
    "expo-image-picker": "56.0.0-canary-20260501-15d3529",
    "expo-linking": "56.0.0-canary-20260501-15d3529",
    "expo-localization": "56.0.0-canary-20260501-15d3529",
    "expo-notifications": "56.0.0-canary-20260501-15d3529",
    "expo-router": "56.0.0-canary-20260501-15d3529",
    "expo-secure-store": "56.0.0-canary-20260501-15d3529",
    "expo-splash-screen": "56.0.0-canary-20260501-15d3529",
    "expo-status-bar": "56.0.0-canary-20260501-15d3529",
    "expo-system-ui": "56.0.0-canary-20260501-15d3529",
    "i18next": "^26.0.8",
    "intl-pluralrules": "^2.0.1",
    "nativewind": "^4.2.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.6",
    "react-native": "0.85.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-pager-view": "^8.0.0",
    "react-native-reanimated": "4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.0-beta.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "use-debounce": "^10.1.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.85.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "56.0.0-canary-20260501-15d3529",
    "eslint": "^8.57.0",
    "eslint-config-expo": "56.0.0-canary-20260501-15d3529",
    "eslint-plugin-i18next": "^6.1.4",
    "jest": "^30.3.0",
    "jest-expo": "56.0.0-canary-20260501-15d3529",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "^19.2.3",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@shopify/flash-list|@gorhom|react-native-draggable-flatlist|nativewind)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.js",
      "^react-native-reanimated$": "<rootDir>/node_modules/react-native-reanimated/mock",
      "^react-native-worklets$": "<rootDir>/node_modules/react-native-worklets/src/mock"
    }
  },
  "private": true
}
