# 1Password vault/item coordinates for signing secrets.
# Copy to .env.op and fill in your actual values.
# .env.op is gitignored — never commit it.

# iOS signing (App Store Connect API key + team)
export OP_IOS_VAULT="<your-vault>"
export OP_IOS_ITEM="AppStoreConnect"

# Android signing (upload keystore + passwords)
export OP_ANDROID_VAULT="<your-vault>"
export OP_ANDROID_ITEM="AndroidSigning"

# Play Console service account credentials
export OP_PLAY_VAULT="<your-vault>"
export OP_PLAY_ITEM="<your-play-credentials-item>"
# export OP_PLAY_FIELD="credential"  # optional, defaults to "credential"
