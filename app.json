{
  "expo": {
    "name": "Threadbase",
    "slug": "threadbase-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "threadbase",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0d1117"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "23",
      "bundleIdentifier": "com.ronenmars.threadbase",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for QR code scanning during server setup and for attaching photos to your Claude Code sessions.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos from your library to your Claude Code sessions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ronenmars.threadbase",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Threadbase to access your camera for QR code scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Threadbase to attach photos from your library to Claude Code sessions.",
          "cameraPermission": false
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "35430e75-2718-4261-a46c-d6f6ff1e27c3"
      }
    },
    "owner": "ronenmars"
  }
}
